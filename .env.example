# .env.example → 복사 후 .env로 사용 (git에 절대 커밋 금지)
# cp .env.example .env

# ── 로컬 개발 ──────────────────────────────
DATABASE_URL=postgresql://postgres:1234@localhost:5432/tastebridge
FLASK_DEBUG=1
PORT=5000
DEFAULT_KEYWORD=삼겹살

# ── AWS 배포 시 RDS 엔드포인트로 교체 ──────
# DATABASE_URL=postgresql://tastebridge_user:STRONG_PW@<rds-endpoint>:5432/tastebridge
# FLASK_DEBUG=0
