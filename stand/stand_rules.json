{
  "version": "2.1",

  "scoring": {
    "positive_hit": 1.0,
    "negative_hit": -0.5,
    "normalization": "scored_count_mean"
  },

  "intensifiers": {
    "아주": 1.3, "엄청": 1.5, "진짜": 1.4, "완전": 1.5,
    "너무": 1.3, "정말": 1.4, "개": 1.5,
    "조금": 0.7, "살짝": 0.6, "약간": 0.7, "좀": 0.8
  },

  "negations": ["안", "않", "못", "별로", "덜", "없"],

  "rating_adjustments": {
    "전반적만족": {
      "taste_ge": [4, 0.3],
      "taste_le": [2, -0.5],
      "total_le": [2, -1.0],
      "total_ge_default": [5, 0.3]
    },
    "양많음": {
      "quantity_ge": [5, 0.2],
      "quantity_le": [2, -0.2]
    }
  },

  "fusion": {
    "text_weight": 0.7,
    "image_weight": 0.3
  },

  "meta_axes_weight": 0.3,
  "taste_axes_weight": 1.0,

  "recommendation": {
    "mode_a": "cosine(user_vec, restaurant_vec)",
    "mode_b": "0.4 * cosine(abs) + 0.6 * cosine(delta)"
  }
}
